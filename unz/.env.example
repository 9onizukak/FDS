# Fill in your hospital account and connection settings after installation.
FDH_USER=
FDH_HOSPITAL_CODE=10731
FDH_HOSPITAL_NAME=โรงพยาบาลพหลพลพยุหเสนา

# ใส่อย่างใดอย่างหนึ่ง:
# (ก) รหัสผ่านดิบ — สคริปต์จะ hash ให้เอง (ลอง sha256 ก่อน แล้ว md5) ← แนะนำ
FDH_PASSWORD=
# (ข) ถ้ามี hash สำเร็จรูปอยู่แล้ว ใส่ตรงนี้แทน (จะข้าม FDH_PASSWORD)
FDH_PASSWORD_HASH=

# ---- ต่อ DB HOSxP (MariaDB) — ใช้ user READ-ONLY เท่านั้น ----
HOSXP_HOST=
HOSXP_PORT=3306
HOSXP_DB=
HOSXP_USER=
HOSXP_PASSWORD=
HOSXP_CHARSET=tis620

# ---- API: UAT หรือ PRODUCTION ----
FDH_ENV=UAT
FDH_UAT_BASE_URL=https://uat-fdh.inet.co.th
FDH_PRODUCTION_BASE_URL=https://fdh.moph.go.th
FDH_TOKEN_URL=https://fdh.moph.go.th/token?Action=get_moph_access_token
